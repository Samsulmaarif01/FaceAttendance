*.onnx
*.pt
*.pth
*.bin
*.engine
*.tflite
*.weights
*.h5

# Vendored model-free detector (small, committed on purpose)
!src/detection/data/*.onnx

# Logs & audit logs
logs/*
!logs/.gitkeep
*.log

